# --- api ---
# DEMO_MODE=1 -> записанные ответы модели, ключ не нужен. Значение по умолчанию.
DEMO_MODE=1
# Нужен только при DEMO_MODE=0
ANTHROPIC_API_KEY=
# Адрес Python-сервиса правил. Не задан -> работают резервные JS-правила.
# Схему можно не писать. 127.0.0.1, а не localhost: на Windows разрешение
# localhost пробует IPv6 и добавляет секунды к каждому запросу.
RULES_URL=127.0.0.1:8000
RULES_TIMEOUT_MS=4000
# Если задан, очередь врача открывается только по ?key=<значение>
DOCTOR_PASSWORD=

# --- web ---
# Адрес Node-API, куда проксирует серверный роут Next.js.
API_URL=127.0.0.1:3001
